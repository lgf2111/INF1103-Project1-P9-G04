# Copy this file to .env and set your Groq API key before assessing messages.
# macOS/Linux: cp .env.example .env
# Windows PowerShell: Copy-Item .env.example .env
# Get a key at https://console.groq.com.
# Git ignores .env by default; check what you stage before committing.
# Insert Railway API Key here. Get from team group chat

GROQ_API_KEY=
DATABASE_URL=
# Logging detail. Leave unset (INFO) for normal safe logs. Set LOG_LEVEL=DEBUG
# to also capture full tracebacks in logs/phishreport.log while debugging
# (e.g. to see exactly why the database won't connect).
LOG_LEVEL=

# AI model selection. Unset GROQ_MODEL uses openai/gpt-oss-20b.
# Optional timeout fallback: choose a different model tested with our full prompt.
# These are examples, not a measured latency/accuracy guarantee. Leave commented
# to retain the default primary and one same-model retry.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Maximum two attempts total; fallback is used only after a socket timeout.
